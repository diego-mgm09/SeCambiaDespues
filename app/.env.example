# Copia este archivo a .env (local) y configura las mismas variables en Vercel → Settings → Environment Variables.
# Cadena de conexión de MongoDB Atlas (Database → Connect → Drivers). Nunca la subas a GitHub.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@TU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Nombre de la base de datos
MONGODB_DB=panoramic
# Secreto para firmar las sesiones (mínimo 16 caracteres, aleatorio). Ej: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
# Solo para el seed: contraseña de los usuarios de demostración (opcional)
# DEMO_PASSWORD=panoramic